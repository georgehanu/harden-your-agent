# Optional. Without a key, everything runs in replay mode (pre-written model turns for the sample requests).
ANTHROPIC_API_KEY=

# Optional. Defaults: claude-opus-5-5 runs the agent, claude-haiku-5-5 reads the request's scope.
SMART_MODEL=
FAST_MODEL=

# Optional. Signs the session cookie. Without it, the app makes a new random secret each time it starts.
SESSION_SECRET=

# Optional. The app's port (default 3100).
PORT=
