{
  "name": "harden-your-agent",
  "version": "1.0.0",
  "description": "Six lessons that add the defences a real product needs to a small TypeScript agent, each proved by a test you can run. By George Hanu.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "George Hanu (https://x.com/georgehanu)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "lesson1": "tsx src/lessons/01-where-untrusted-text-gets-in.ts",
    "lesson2": "tsx src/lessons/02-keep-the-agent-on-task.ts",
    "lesson3": "tsx src/lessons/03-the-screen-and-the-fetch-tool.ts",
    "lesson4": "tsx src/lessons/04-acting-as-whom.ts",
    "lesson5": "tsx src/lessons/05-tools-that-must-not-run-twice.ts",
    "lesson6": "tsx src/lessons/06-memory-you-can-trust.ts",
    "harden-check": "tsx harden/check.ts",
    "typecheck": "tsc --noEmit",
    "site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.0",
    "marked-highlight": "^2.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
